@page "/admin/youth/{Id:int}/edit"
@* Any signed-in user can correct a youth's details — volunteers reach this from the
   check-in screen ("Edit details", which adds ?from=checkin) and the check-in log. The
   archive/restore controls further down stay admin-only, since hiding a youth from
   check-in search is profile management rather than fixing a mistake. *@
@attribute [Authorize]
@inject YouthService YouthService
@inject NavigationManager Navigation
@inject ToastService Toasts
@inject ILogger<EditYouth> Logger

<PageTitle>Edit details — SG Check-In</PageTitle>

<div class="register-page">
    @if (youth is null)
    {
        <p class="empty-state">No one with that ID in @group.ToDisplayString().</p>
    }
    else
    {
        <h1>Edit @youth.FullName</h1>

        <EditForm Model="form" OnValidSubmit="HandleValidSubmit" OnInvalidSubmit="ShowFixFieldsError" FormName="edit-youth">
            <DataAnnotationsValidator />
            <LiveValidation />

            <fieldset>
                <legend>@group.PersonNoun().Capitalised() details</legend>

                <label class="field">
                    <span class="field-label">Name <span class="required" aria-hidden="true">*</span></span>
                    <InputText @bind-Value="form.Name" />
                    <ValidationMessage For="() => form.Name" />
                </label>

                <label class="field">
                    <span class="field-label">Surname <span class="required" aria-hidden="true">*</span></span>
                    <InputText @bind-Value="form.Surname" />
                    <ValidationMessage For="() => form.Surname" />
                </label>

                @if (group.HasOwnCell())
                {
                    <label class="field">
                        <span class="field-label">Cell number <span class="required" aria-hidden="true">*</span></span>
                        <InputText @bind-Value="form.CellNo" type="tel" />
                        <ValidationMessage For="() => form.CellNo" />
                    </label>
                }

                @if (group.HasGrades())
                {
                    <label class="field">
                        <span class="field-label">Grade <span class="required" aria-hidden="true">*</span></span>
                        <InputSelect @bind-Value="form.Grade">
                            <option value="">Select a grade…</option>
                            @foreach (var grade in group.Grades())
                            {
                                <option value="@grade">@grade.ToDisplayString()</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => form.Grade" />
                    </label>
                }

                <label class="field">
                    <span class="field-label">Date of birth <span class="required" aria-hidden="true">*</span></span>
                    <DateField @bind-Value="form.DateOfBirth" />
                    <ValidationMessage For="() => form.DateOfBirth" />
                    @* Which ministry the date puts them in, as soon as it's typed. *@
                    @if (group.HasMinistries() && form.DateOfBirth is { } dob && MinistryHint(dob) is { } hint)
                    {
                        <p class="field-hint">@hint</p>
                    }
                </label>

                @if (group.HasGender())
                {
                    <div class="field">
                        <span class="field-label">Boy or girl <span class="required" aria-hidden="true">*</span></span>
                        <InputRadioGroup @bind-Value="form.Gender">
                            <div class="choice-toggle">
                                <label><InputRadio Value="(Gender?)Gender.Boy" /><span>Boy</span></label>
                                <label><InputRadio Value="(Gender?)Gender.Girl" /><span>Girl</span></label>
                            </div>
                        </InputRadioGroup>
                        <ValidationMessage For="() => form.Gender" />
                    </div>
                }

                @if (group.HasMedical())
                {
                    <label class="field">
                        <span class="field-label">Medical &amp; allergies <span class="optional">(optional, printed on their label)</span></span>
                        <InputText @bind-Value="form.Medical" placeholder="e.g. peanut allergy, asthma pump in bag" />
                        <ValidationMessage For="() => form.Medical" />
                    </label>
                }
            </fieldset>

            @if (group.HasParents())
            {
            <fieldset>
                <legend>Parent / guardian details</legend>

                <label class="field">
                    <span class="field-label">Parent's name <span class="required" aria-hidden="true">*</span></span>
                    <InputText @bind-Value="form.ParentName" />
                    <ValidationMessage For="() => form.ParentName" />
                </label>

                <label class="field">
                    <span class="field-label">Parent's surname <span class="required" aria-hidden="true">*</span></span>
                    <InputText @bind-Value="form.ParentSurname" />
                    <ValidationMessage For="() => form.ParentSurname" />
                </label>

                <label class="field">
                    <span class="field-label">Parent's cell number <span class="required" aria-hidden="true">*</span></span>
                    <InputText @bind-Value="form.ParentCellNo" type="tel" />
                    <ValidationMessage For="() => form.ParentCellNo" />
                </label>
            </fieldset>
            }

            @* Only the behaviour status is admin-only to change. Volunteers still see it —
               a leader on the floor needs to know a youth is flagged — but read-only.
               YouthService.UpdateAsync ignores it for a non-admin whatever gets posted,
               so hiding the input is presentation, not the actual guard. *@
            <fieldset>
                <legend>Leaders' notes</legend>

                @* The status is Youth only, CMR Kids only, Care Village both; every group has the comment.
                   A child is with CMR or in Care Village, never both: ticking one clears the other. *@
                @if (group.HasLeaderFlags() && isAdmin)
                {
                    <label class="field">
                        <span class="field-label">Status</span>
                        <InputSelect @bind-Value="form.BehaviourStatus">
                            @foreach (var status in Enum.GetValues<BehaviourStatus>())
                            {
                                <option value="@status">@status.ToDisplayString()</option>
                            }
                        </InputSelect>
                    </label>
                }
                else if (group.HasLeaderFlags())
                {
                    <div class="field">
                        <span class="field-label">Status</span>
                        <p class="status-badges">
                            <span class="status-badge @form.BehaviourStatus.ToCssModifier()">
                                @form.BehaviourStatus.ToDisplayString()
                            </span>
                        </p>
                        <p class="field-hint">Only an admin can change the status.</p>
                    </div>
                }

                @* Care Village is its own flag, not a third status: a youth can be
                   flagged red and in Care Village at the same time. *@
                @if (group.HasCmr())
                {
                    <label class="checkbox-field">
                        <InputCheckbox @bind-Value="form.InCmr" @bind-Value:after="() => { if (form.InCmr) form.InCareVillage = false; }" />
                        <span>CMR</span>
                    </label>
                }
                @if (group.HasCareVillage())
                {
                    <label class="checkbox-field">
                        <InputCheckbox @bind-Value="form.InCareVillage" @bind-Value:after="() => { if (form.InCareVillage) form.InCmr = false; }" />
                        <span>Care Village</span>
                    </label>
                    <ValidationMessage For="() => form.InCmr" />
                }

                <label class="field">
                    <span class="field-label">Comment <span class="optional">(optional)</span></span>
                    <InputTextArea @bind-Value="form.Comment" rows="4"
                                   placeholder="@group.CommentPlaceholder()" />
                    <ValidationMessage For="() => form.Comment" />
                </label>
            </fieldset>

            @* Volunteers have no access to /admin/profiles, so sending them there would
               bounce them to the login screen. Point each role at a page it can open. *@
            <div class="form-actions">
                @* Context named explicitly: nested inside EditForm, the implicit "context"
                   parameter name would collide with the form's own. *@
                @if (FromCheckIn)
                {
                    <a href="@CheckInUrl" class="cancel-link">Back to check-in</a>
                }
                else
                {
                    <AuthorizeView Roles="@Roles.Admin" Context="auth">
                        <Authorized>
                            <a href="/admin/profiles" class="cancel-link">Back to profiles</a>
                        </Authorized>
                        <NotAuthorized>
                            <a href="/admin/log" class="cancel-link">Back to log</a>
                        </NotAuthorized>
                    </AuthorizeView>
                }
                <button type="submit" class="submit-button">Save changes</button>
            </div>
        </EditForm>

        <AuthorizeView Roles="@Roles.Admin">
        <div class="archive-section">
            @if (youth.IsArchived)
            {
                <p>This @group.PersonNoun() is archived — hidden from check-in search.</p>
                <button type="button" class="archive-button restore" @onclick="DoUnarchive">Restore this @group.PersonNoun()</button>
            }
            else if (!confirmingArchive)
            {
                <button type="button" class="archive-button" @onclick="() => confirmingArchive = true">
                    Archive this @group.PersonNoun()
                </button>
            }
            else
            {
                <p>Archiving removes them from search but keeps their check-in history. Are you sure?</p>
                <div class="archive-confirm-actions">
                    <button type="button" class="archive-confirm-button" @onclick="DoArchive">Yes, archive</button>
                    <button type="button" class="cancel-link" @onclick="() => confirmingArchive = false">Cancel</button>
                </div>
            }
        </div>
        </AuthorizeView>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    // "checkin" when opened from the check-in screen: saving goes straight back there with
    // this youth still selected, ready to check in.
    [SupplyParameterFromQuery(Name = "from")]
    private string? From { get; set; }

    private bool FromCheckIn => From == "checkin";

    private string CheckInUrl => $"/?youth={Id}";

    private Group group = Group.Youth;
    private Youth? youth;
    private YouthFormModel form = new();
    private bool confirmingArchive;
    private bool isAdmin;

    protected override async Task OnParametersSetAsync()
    {
        isAdmin = await IsAdminAsync();
        group = await AuthState.GetGroupAsync();

        youth = await YouthService.GetByIdAsync(Id, group);
        if (youth is not null)
        {
            form = YouthFormModel.FromYouth(youth);
        }
    }

    private async Task<bool> IsAdminAsync()
    {
        if (AuthState is null)
        {
            return false;
        }

        var state = await AuthState;
        return state.User.IsInRole(Roles.Admin);
    }

    private async Task HandleValidSubmit()
    {
        try
        {
            // Re-read the role at submit time rather than trusting the field set during render.
            await YouthService.UpdateAsync(Id, group, form, await IsAdminAsync());
            Toasts.ShowSuccess("Saved successfully");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Saving youth {YouthId} failed", Id);
            Toasts.ShowError("Couldn't save the changes. Please try again.");
            return;
        }

        if (FromCheckIn)
        {
            Navigation.NavigateTo(CheckInUrl);
        }
    }

    private void ShowFixFieldsError() =>
        Toasts.ShowError("Not saved. Fix the fields marked in red.");

    private async Task DoArchive()
    {
        try
        {
            await YouthService.ArchiveAsync(Id, group);
            Toasts.ShowSuccess($"{youth?.FullName} archived");
            Navigation.NavigateTo("/admin/profiles");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Archiving youth {YouthId} failed", Id);
            Toasts.ShowError("Couldn't archive them. Please try again.");
        }
    }

    private async Task DoUnarchive()
    {
        try
        {
            await YouthService.UnarchiveAsync(Id, group);
            youth = await YouthService.GetByIdAsync(Id, group);
            Toasts.ShowSuccess($"{youth?.FullName} restored");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Restoring youth {YouthId} failed", Id);
            Toasts.ShowError("Couldn't restore them. Please try again.");
        }
    }

    // Kids: the ministry the date of birth puts them in, or when they can join. (A new
    // child too young to join gets the form's own message instead, on Register.)
    private string? MinistryHint(DateOnly dob)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        if (KidsMinistries.IsTooOld(dob, today))
        {
            return form.IsNew ? null : $"Past Kids' Ministry: turns {KidsMinistries.AgeThisYear(dob, today)} this year.";
        }
        if (KidsMinistries.For(dob, today) is { } ministry)
        {
            return $"{ministry.ToDisplayString()} · age {Birthdays.AgeOn(dob, today)}";
        }
        return form.IsNew ? null : $"Not in a ministry yet: they can join in {KidsMinistries.JoiningYear(dob)}.";
    }
}
