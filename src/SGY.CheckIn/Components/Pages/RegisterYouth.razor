@page "/register"
@attribute [Authorize]
@inject YouthService YouthService
@inject CheckInService CheckInService
@inject NavigationManager Navigation
@inject ToastService Toasts
@inject LabelPrinting Labels
@inject ILogger<RegisterYouth> Logger

<PageTitle>Register — SG Check-In</PageTitle>

<div class="register-page">
    <h1>Register a new @group.PersonNoun()</h1>

    @if (similarMatches.Count > 0)
    {
        <div class="duplicate-nudge" role="status">
            <p>
                Found @(similarMatches.Count == 1 ? "someone" : "some people") with a similar name already registered:
                <strong>@string.Join(", ", similarMatches.Select(m => group.Describe(m, DateOnly.FromDateTime(DateTime.Today)) is { } d ? $"{m.FullName} ({d})" : m.FullName))</strong>
            </p>
            <p>If that's who you're looking for, <a href="/">search for them instead</a> — no need to register a duplicate.</p>
        </div>
    }

    <EditForm Model="form" OnValidSubmit="HandleValidSubmit" OnInvalidSubmit="ShowFixFieldsError" FormName="register-youth">
        <DataAnnotationsValidator />
        <LiveValidation />

        <fieldset>
            <legend>@group.PersonNoun().Capitalised() details</legend>

            <label class="field">
                <span class="field-label">Name <span class="required" aria-hidden="true">*</span></span>
                <InputText @bind-Value="form.Name" @bind-Value:after="OnNameOrSurnameChanged" type="text" />
                <ValidationMessage For="() => form.Name" />
            </label>

            <label class="field">
                <span class="field-label">Surname <span class="required" aria-hidden="true">*</span></span>
                <InputText @bind-Value="form.Surname" @bind-Value:after="OnSurnameChanged" type="text" />
                <ValidationMessage For="() => form.Surname" />
            </label>

            @if (group.HasOwnCell())
            {
                <label class="field">
                    <span class="field-label">Cell number <span class="required" aria-hidden="true">*</span></span>
                    <InputText @bind-Value="form.CellNo" type="tel" />
                    <ValidationMessage For="() => form.CellNo" />
                </label>
            }

            @if (group.HasGrades())
            {
                <label class="field">
                    <span class="field-label">Grade <span class="required" aria-hidden="true">*</span></span>
                    <InputSelect @bind-Value="form.Grade">
                        <option value="">Select a grade…</option>
                        @foreach (var grade in group.Grades())
                        {
                            <option value="@grade">@grade.ToDisplayString()</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => form.Grade" />
                </label>
            }

            <label class="field">
                <span class="field-label">Date of birth <span class="required" aria-hidden="true">*</span></span>
                <DateField @bind-Value="form.DateOfBirth" />
                <ValidationMessage For="() => form.DateOfBirth" />
                @* Which ministry the date puts them in, as soon as it's typed. *@
                @if (group.HasMinistries() && form.DateOfBirth is { } dob && MinistryHint(dob) is { } hint)
                {
                    <p class="field-hint">@hint</p>
                }
            </label>

            @* Past Kids' Ministry: a volunteer can still register them, for today. *@
            @if (group.HasMinistries() && form.DateOfBirth is { } born && KidsMinistries.IsTooOld(born, DateOnly.FromDateTime(DateTime.Today)))
            {
                <div class="age-flag" role="alert">
                    <p>Turns @KidsMinistries.AgeThisYear(born, DateOnly.FromDateTime(DateTime.Today)) this year: too old for Kids' Ministry, which ends with Refuel at 13.</p>
                    <label class="checkbox-field">
                        <InputCheckbox @bind-Value="form.TooOldException" />
                        <span>Make an exception today</span>
                    </label>
                    <ValidationMessage For="() => form.TooOldException" />
                </div>
            }

            @if (group.HasGender())
            {
                <div class="field">
                    <span class="field-label">Boy or girl <span class="required" aria-hidden="true">*</span></span>
                    <InputRadioGroup @bind-Value="form.Gender">
                        <div class="choice-toggle">
                            <label><InputRadio Value="(Gender?)Gender.Boy" /><span>Boy</span></label>
                            <label><InputRadio Value="(Gender?)Gender.Girl" /><span>Girl</span></label>
                        </div>
                    </InputRadioGroup>
                    <ValidationMessage For="() => form.Gender" />
                </div>
            }

            @if (group.HasMedical())
            {
                <label class="field">
                    <span class="field-label">Medical &amp; allergies <span class="optional">(optional, printed on their label)</span></span>
                    <InputText @bind-Value="form.Medical" type="text" placeholder="e.g. peanut allergy, asthma pump in bag" />
                    <ValidationMessage For="() => form.Medical" />
                </label>
            }
        </fieldset>

        @if (group.HasParents())
        {
        <fieldset>
            <legend>Parent / guardian details</legend>

            <label class="field">
                <span class="field-label">Parent's name <span class="required" aria-hidden="true">*</span></span>
                <InputText @bind-Value="form.ParentName" type="text" />
                <ValidationMessage For="() => form.ParentName" />
            </label>

            <div class="field">
                <span class="field-label field-label-row">
                    <span>Parent's surname <span class="required" aria-hidden="true">*</span></span>
                    <label class="same-surname">
                        <input type="checkbox" checked="@sameSurname" @onchange="OnSameSurnameChanged" />
                        Same as child
                    </label>
                </span>
                <InputText @bind-Value="form.ParentSurname" type="text" disabled="@sameSurname" />
                <ValidationMessage For="() => form.ParentSurname" />
            </div>

            <label class="field">
                <span class="field-label">Parent's cell number <span class="required" aria-hidden="true">*</span></span>
                <InputText @bind-Value="form.ParentCellNo" type="tel" />
                <ValidationMessage For="() => form.ParentCellNo" />
            </label>
        </fieldset>
        }

        @* The status is admin-only, same as on the edit page: a volunteer registering a
           youth just gets the default green status. The status is Youth only, CMR Kids
           only, Care Village both (a child is with CMR or in Care Village, never both:
           ticking one clears the other); every group keeps the comment. *@
        <fieldset>
            <legend>Leaders' notes</legend>

            @if (isAdmin && group.HasLeaderFlags())
            {
                <label class="field">
                    <span class="field-label">Status</span>
                    <InputSelect @bind-Value="form.BehaviourStatus">
                        @foreach (var status in Enum.GetValues<BehaviourStatus>())
                        {
                            <option value="@status">@status.ToDisplayString()</option>
                        }
                    </InputSelect>
                </label>
            }

            @* Independent of the status above — a youth can be both. *@
            @if (group.HasCmr())
            {
                <label class="checkbox-field">
                    <InputCheckbox @bind-Value="form.InCmr" @bind-Value:after="() => { if (form.InCmr) form.InCareVillage = false; }" />
                    <span>CMR</span>
                </label>
            }
            @if (group.HasCareVillage())
            {
                <label class="checkbox-field">
                    <InputCheckbox @bind-Value="form.InCareVillage" @bind-Value:after="() => { if (form.InCareVillage) form.InCmr = false; }" />
                    <span>Care Village</span>
                </label>
                <ValidationMessage For="() => form.InCmr" />
            }

            <label class="field">
                <span class="field-label">Comment <span class="optional">(optional)</span></span>
                <InputTextArea @bind-Value="form.Comment" rows="4"
                               placeholder="@group.CommentPlaceholder()" />
                <ValidationMessage For="() => form.Comment" />
            </label>
        </fieldset>

        <div class="form-actions">
            <a href="/" class="btn-cancel">Cancel</a>
            <button type="submit" class="btn-register" disabled="@isSubmitting"
                    @onclick="() => checkInAfter = false">
                Register
            </button>
            <button type="submit" class="btn-register-checkin" disabled="@isSubmitting"
                    @onclick="() => checkInAfter = true">
                @(isSubmitting ? "Working…" : "Register & Check In")
            </button>
        </div>
    </EditForm>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private YouthFormModel form = new();
    private Group group = Group.Youth;
    private bool isAdmin;
    private List<Youth> similarMatches = [];
    private bool isSubmitting;
    private bool checkInAfter = true;   // set by whichever submit button was pressed
    private bool sameSurname;           // ticked by the volunteer when the parent shares the child's surname
    private CancellationTokenSource? similarCts;

    protected override async Task OnInitializedAsync()
    {
        group = await AuthState.GetGroupAsync();
        form.Group = group;
        form.IsNew = true;
        isAdmin = await IsAdminAsync();
    }

    private async Task<bool> IsAdminAsync()
    {
        if (AuthState is null)
        {
            return false;
        }

        var state = await AuthState;
        return state.User.IsInRole(Roles.Admin);
    }

    private void OnSameSurnameChanged(ChangeEventArgs e)
    {
        sameSurname = e.Value as bool? ?? false;
        if (sameSurname)
        {
            form.ParentSurname = form.Surname;
        }
    }

    private async Task OnSurnameChanged()
    {
        if (sameSurname)
        {
            form.ParentSurname = form.Surname;
        }
        await OnNameOrSurnameChanged();
    }

    private async Task OnNameOrSurnameChanged()
    {
        similarCts?.Cancel();
        var cts = new CancellationTokenSource();
        similarCts = cts;
        try
        {
            await Task.Delay(400, cts.Token);
            var found = await YouthService.FindSimilarAsync(form.Name, form.Surname, group, cts.Token);
            if (cts.Token.IsCancellationRequested)
            {
                return;
            }
            similarMatches = found;
            StateHasChanged();
        }
        catch (TaskCanceledException)
        {
            // expected when the user keeps typing
        }
    }

    private async Task HandleValidSubmit()
    {
        isSubmitting = true;
        Youth youth;
        try
        {
            // Re-read the role at submit time rather than trusting the field set during render.
            youth = await YouthService.CreateAsync(form, await IsAdminAsync());
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Registering a youth failed");
            Toasts.ShowError("Couldn't register them. Please try again.");
            isSubmitting = false;
            return;
        }

        if (!checkInAfter)
        {
            Toasts.ShowSuccess($"{youth.FullName} registered (not checked in yet)");
        }
        else
        {
            try
            {
                await CheckInService.CheckInAsync(youth.Id, group);
                Toasts.ShowSuccess($"{youth.FullName} registered and checked in");
                // As on the check-in page: a Kids child gets their name label straight away,
                // printed here or sent to the print station, as this device is set up.
                await Labels.PrintAsync(youth, group);
            }
            catch (Exception ex)
            {
                // They're saved, so don't send the volunteer back to register them twice.
                Logger.LogError(ex, "Checking in newly registered youth {YouthId} failed", youth.Id);
                Toasts.ShowError($"{youth.FullName} is registered, but the check-in failed. Search for them to check in.");
            }
        }
        Navigation.NavigateTo("/");
    }

    private void ShowFixFieldsError() =>
        Toasts.ShowError("Not registered yet. Fix the fields marked in red.");

    // Kids: the ministry the date of birth puts them in, or when they can join. (A new
    // child too young to join gets the form's own message instead, on Register.)
    private string? MinistryHint(DateOnly dob)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        if (KidsMinistries.IsTooOld(dob, today))
        {
            return form.IsNew ? null : $"Past Kids' Ministry: turns {KidsMinistries.AgeThisYear(dob, today)} this year.";
        }
        if (KidsMinistries.For(dob, today) is { } ministry)
        {
            return $"{ministry.ToDisplayString()} · age {Birthdays.AgeOn(dob, today)}";
        }
        return form.IsNew ? null : $"Not in a ministry yet: they can join in {KidsMinistries.JoiningYear(dob)}.";
    }
}
