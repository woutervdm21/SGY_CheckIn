@page "/register"
@attribute [Authorize]
@inject YouthService YouthService
@inject CheckInService CheckInService
@inject NavigationManager Navigation
@inject ToastService Toasts
@inject ILogger<RegisterYouth> Logger

<PageTitle>Register — SGY Check-In</PageTitle>

<div class="register-page">
    <h1>Register a new youth</h1>
    <p class="page-subtitle">Use "Register &amp; Check In" if they're here now, or "Register" to just add them.</p>

    @if (similarMatches.Count > 0)
    {
        <div class="duplicate-nudge" role="status">
            <p>
                Found @(similarMatches.Count == 1 ? "someone" : "some people") with a similar name already registered:
                <strong>@string.Join(", ", similarMatches.Select(m => $"{m.FullName} ({m.Grade.ToDisplayString()})"))</strong>
            </p>
            <p>If that's who you're looking for, <a href="/">search for them instead</a> — no need to register a duplicate.</p>
        </div>
    }

    <EditForm Model="form" OnValidSubmit="HandleValidSubmit" OnInvalidSubmit="ShowFixFieldsError" FormName="register-youth">
        <DataAnnotationsValidator />

        <fieldset>
            <legend>Youth details</legend>

            <label class="field">
                <span class="field-label">Name</span>
                <InputText @bind-Value="form.Name" @bind-Value:after="OnNameOrSurnameChanged" type="text" />
                <ValidationMessage For="() => form.Name" />
            </label>

            <label class="field">
                <span class="field-label">Surname</span>
                <InputText @bind-Value="form.Surname" @bind-Value:after="OnSurnameChanged" type="text" />
                <ValidationMessage For="() => form.Surname" />
            </label>

            <label class="field">
                <span class="field-label">Cell number</span>
                <InputText @bind-Value="form.CellNo" type="tel" />
                <ValidationMessage For="() => form.CellNo" />
            </label>

            <label class="field">
                <span class="field-label">Grade</span>
                <InputSelect @bind-Value="form.Grade">
                    <option value="">Select a grade…</option>
                    @foreach (var grade in Enum.GetValues<Grade>())
                    {
                        <option value="@grade">@grade.ToDisplayString()</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => form.Grade" />
            </label>

            <label class="field">
                <span class="field-label">Date of birth</span>
                <DateField @bind-Value="form.DateOfBirth" />
                <ValidationMessage For="() => form.DateOfBirth" />
            </label>
        </fieldset>

        <fieldset>
            <legend>Parent / guardian details</legend>

            <label class="field">
                <span class="field-label">Parent's name</span>
                <InputText @bind-Value="form.ParentName" type="text" />
                <ValidationMessage For="() => form.ParentName" />
            </label>

            <div class="field">
                <span class="field-label field-label-row">
                    <span>Parent's surname</span>
                    <label class="same-surname">
                        <input type="checkbox" checked="@sameSurname" @onchange="OnSameSurnameChanged" />
                        Same as child
                    </label>
                </span>
                <InputText @bind-Value="form.ParentSurname" type="text" disabled="@sameSurname" />
                <ValidationMessage For="() => form.ParentSurname" />
            </div>

            <label class="field">
                <span class="field-label">Parent's cell number</span>
                <InputText @bind-Value="form.ParentCellNo" type="tel" />
                <ValidationMessage For="() => form.ParentCellNo" />
            </label>
        </fieldset>

        @* The status is admin-only, same as on the edit page: a volunteer registering a
           youth just gets the default green status. *@
        <fieldset>
            <legend>Leaders' notes</legend>

            @if (isAdmin)
            {
                <label class="field">
                    <span class="field-label">Status</span>
                    <InputSelect @bind-Value="form.BehaviourStatus">
                        @foreach (var status in Enum.GetValues<BehaviourStatus>())
                        {
                            <option value="@status">@status.ToDisplayString()</option>
                        }
                    </InputSelect>
                </label>
            }

            @* Independent of the status above — a youth can be both. *@
            <label class="checkbox-field">
                <InputCheckbox @bind-Value="form.InCareVillage" />
                <span>Care Village</span>
            </label>

            <label class="field">
                <span class="field-label">Comment <span class="optional">(optional)</span></span>
                <InputTextArea @bind-Value="form.Comment" rows="4"
                               placeholder="Anything leaders should know — allergies, pastoral notes." />
                <ValidationMessage For="() => form.Comment" />
            </label>
        </fieldset>

        <div class="form-actions">
            <a href="/" class="btn-cancel">Cancel</a>
            <button type="submit" class="btn-register" disabled="@isSubmitting"
                    @onclick="() => checkInAfter = false">
                Register
            </button>
            <button type="submit" class="btn-register-checkin" disabled="@isSubmitting"
                    @onclick="() => checkInAfter = true">
                @(isSubmitting ? "Working…" : "Register & Check In")
            </button>
        </div>
    </EditForm>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private YouthFormModel form = new();
    private bool isAdmin;
    private List<Youth> similarMatches = [];
    private bool isSubmitting;
    private bool checkInAfter = true;   // set by whichever submit button was pressed
    private bool sameSurname;           // ticked by the volunteer when the parent shares the child's surname
    private CancellationTokenSource? similarCts;

    protected override async Task OnInitializedAsync()
    {
        isAdmin = await IsAdminAsync();
    }

    private async Task<bool> IsAdminAsync()
    {
        if (AuthState is null)
        {
            return false;
        }

        var state = await AuthState;
        return state.User.IsInRole(Roles.Admin);
    }

    private void OnSameSurnameChanged(ChangeEventArgs e)
    {
        sameSurname = e.Value as bool? ?? false;
        if (sameSurname)
        {
            form.ParentSurname = form.Surname;
        }
    }

    private async Task OnSurnameChanged()
    {
        if (sameSurname)
        {
            form.ParentSurname = form.Surname;
        }
        await OnNameOrSurnameChanged();
    }

    private async Task OnNameOrSurnameChanged()
    {
        similarCts?.Cancel();
        var cts = new CancellationTokenSource();
        similarCts = cts;
        try
        {
            await Task.Delay(400, cts.Token);
            var found = await YouthService.FindSimilarAsync(form.Name, form.Surname, cts.Token);
            if (cts.Token.IsCancellationRequested)
            {
                return;
            }
            similarMatches = found;
            StateHasChanged();
        }
        catch (TaskCanceledException)
        {
            // expected when the user keeps typing
        }
    }

    private async Task HandleValidSubmit()
    {
        isSubmitting = true;
        Youth youth;
        try
        {
            // Re-read the role at submit time rather than trusting the field set during render.
            youth = await YouthService.CreateAsync(form, await IsAdminAsync());
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Registering a youth failed");
            Toasts.ShowError("Couldn't register them. Please try again.");
            isSubmitting = false;
            return;
        }

        if (!checkInAfter)
        {
            Toasts.ShowSuccess($"{youth.FullName} registered (not checked in yet)");
        }
        else
        {
            try
            {
                await CheckInService.CheckInAsync(youth.Id);
                Toasts.ShowSuccess($"{youth.FullName} registered and checked in");
            }
            catch (Exception ex)
            {
                // They're saved, so don't send the volunteer back to register them twice.
                Logger.LogError(ex, "Checking in newly registered youth {YouthId} failed", youth.Id);
                Toasts.ShowError($"{youth.FullName} is registered, but the check-in failed. Search for them to check in.");
            }
        }
        Navigation.NavigateTo("/");
    }

    private void ShowFixFieldsError() =>
        Toasts.ShowError("Not registered yet. Fix the fields marked in red.");
}
