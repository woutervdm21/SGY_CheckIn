@page "/login"
@attribute [AllowAnonymous]
@layout Layout.LoginLayout

<PageTitle>Sign in — SG Check-In</PageTitle>

@* Two steps: pick the group, then sign in. The group decides which people the app shows
   and which volunteer password works (the admin password works for every group). The
   step lives in the query string (?group=), so Back and refresh behave, and returnUrl is
   carried through every step. *@
<div class="login-card">
    <img src="sg-logo.avif" alt="SG" class="login-logo" />
    <h1>SG Check-In</h1>

    @if (SelectedGroup is null)
    {
        <p class="login-prompt">Choose a group</p>
        <div class="group-choices">
            @foreach (var group in Enum.GetValues<Group>())
            {
                <a href="@StepUrl(group.ToKey())" class="group-choice">
                    <span class="group-choice-name">@group.ToDisplayString()</span>
                </a>
            }
        </div>
    }
    else
    {
        <p class="login-group-chip">@SelectedGroup.Value.ToDisplayString()</p>

        @if (HasError)
        {
            <p class="login-error" role="alert">That password isn't right — try again.</p>
        }

        <form method="post" action="/account/login" class="login-form">
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />
            <input type="hidden" name="group" value="@SelectedGroup.Value.ToKey()" />
            <input
                type="password"
                name="password"
                placeholder="Enter Password"
                autofocus
                autocomplete="current-password"
                class="login-password-input" />
            <button type="submit" class="login-submit">Sign in</button>
        </form>
        <a href="@StepUrl(null)" class="login-back">← Choose a different group</a>
    }

    <p class="login-version">v@(AppInfo.Version)</p>
</div>

@code {
    [SupplyParameterFromQuery(Name = "group")]
    private string? GroupKey { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    private string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    private string? ReturnUrl { get; set; }

    // A failed sign-in comes back with ?error=1 and the group it was for.
    private Group? SelectedGroup =>
        GroupExtensions.FromKey(HasError ? GroupKey ?? "youth" : GroupKey);

    private bool HasError => Error == "1";

    private string StepUrl(string? group)
    {
        var query = new List<string>();
        if (group is not null)
        {
            query.Add($"group={group}");
        }
        if (!string.IsNullOrEmpty(ReturnUrl))
        {
            query.Add($"returnUrl={Uri.EscapeDataString(ReturnUrl)}");
        }
        return query.Count == 0 ? "/login" : $"/login?{string.Join('&', query)}";
    }
}
