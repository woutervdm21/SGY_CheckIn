@page "/admin/log"
@attribute [Authorize]
@inject CheckInService CheckInService
@inject ToastService Toasts
@inject ILogger<AdminLog> Logger

<PageTitle>Check-In Log — SG Check-In</PageTitle>

<div class="admin-log-page">
    <h1>Check-in log</h1>

    <div class="log-toolbar">
        <label class="field">
            <span class="field-label">Date</span>
            <DateField Value="selectedDate" ValueChanged="OnDateChanged" />
        </label>
        <a href="/" class="log-back-button">Back to Check In</a>
    </div>

    @if (checkIns.Count == 0)
    {
        <p class="empty-state">No check-ins on @selectedDate.ToString("dddd, d MMMM yyyy").</p>
    }
    else
    {
        <p class="log-count">
            @checkIns.Count check-in@(checkIns.Count == 1 ? "" : "s")
            @if (group.HasCheckOut())
            {
                var checkedOut = checkIns.Count(c => c.CheckedOutAt is not null);
                <span> · @checkedOut checked out · @(checkIns.Count - checkedOut) not checked out</span>
            }
        </p>
        <div class="log-table-wrap">
            <table class="log-table">
                <thead>
                    <tr>
                        <th>Time</th>
                        @if (group.HasCheckOut())
                        {
                            <th>Out</th>
                        }
                        <th>Name</th>
                        @if (group != Group.YoungAdults)
                        {
                            <th>@(group.HasMinistries() ? "Ministry" : "Grade")</th>
                        }
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in checkIns)
                    {
                        <tr>
                            <td>@FormatLocalTime(c.Timestamp)</td>
                            @if (group.HasCheckOut())
                            {
                                <td>@(c.CheckedOutAt is { } outAt ? FormatLocalTime(outAt) : "–")</td>
                            }
                            <td>@c.Youth.FullName</td>
                            @if (group != Group.YoungAdults)
                            {
                                <td>@group.Describe(c.Youth, DateOnly.FromDateTime(c.Timestamp.ToLocalTime()))</td>
                            }
                            @* Open to volunteers too: whoever checked a youth in is the one
                               most likely to spot a mistake in their details, and they can
                               already enter those same details when registering. Archiving
                               stays admin-only — see EditYouth. *@
                            <td class="log-actions">
                                <a href="@($"/admin/youth/{c.YouthId}/edit")">Edit</a>
                                @if (CanUndo)
                                {
                                    <button type="button" class="log-undo-button"
                                            @onclick="() => confirmingUndoId = c.Id">Undo</button>
                                }
                            </td>
                        </tr>
                        @if (confirmingUndoId == c.Id)
                        {
                            <tr class="log-undo-confirm">
                                <td colspan="@((group != Group.YoungAdults ? 4 : 3) + (group.HasCheckOut() ? 1 : 0))">
                                    <p>Undo @c.Youth.FullName's check-in at @FormatLocalTime(c.Timestamp)? Are you sure?</p>
                                    <div class="archive-confirm-actions">
                                        <button type="button" class="archive-confirm-button" @onclick="() => DoUndo(c)">Yes, undo</button>
                                        <button type="button" class="cancel-link" @onclick="() => confirmingUndoId = null">Cancel</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private Group group = Group.Youth;
    private DateOnly selectedDate = DateOnly.FromDateTime(DateTime.Now);
    private List<CheckInRecord> checkIns = [];
    private int? confirmingUndoId;
    private bool isAdmin;

    // Volunteers can undo today's check-ins (the one they just made by mistake); only
    // admins can change past days. CheckInService enforces the same rule.
    private bool CanUndo => isAdmin || selectedDate == DateOnly.FromDateTime(DateTime.Now);

    protected override async Task OnInitializedAsync()
    {
        isAdmin = await IsAdminAsync();
        group = await AuthState.GetGroupAsync();
        await LoadAsync();
    }

    private async Task<bool> IsAdminAsync()
    {
        if (AuthState is null)
        {
            return false;
        }

        var state = await AuthState;
        return state.User.IsInRole(Roles.Admin);
    }

    private async Task DoUndo(CheckInRecord checkIn)
    {
        confirmingUndoId = null;
        bool removed;
        try
        {
            // Re-read the role at click time rather than trusting the field set during render.
            removed = await CheckInService.UndoCheckInAsync(checkIn.Id, group, await IsAdminAsync());
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Undoing check-in {CheckInId} failed", checkIn.Id);
            Toasts.ShowError($"Couldn't undo {checkIn.Youth.FullName}'s check-in. Please try again.");
            return;
        }

        if (removed)
        {
            Toasts.ShowSuccess($"{checkIn.Youth.FullName}'s check-in undone");
        }
        else
        {
            Toasts.ShowError("That check-in couldn't be undone. It may already be gone, or only an admin can change past days.");
        }
        await LoadAsync();
    }

    private async Task OnDateChanged(DateOnly? value)
    {
        if (value is { } date)
        {
            selectedDate = date;
            confirmingUndoId = null;
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        checkIns = await CheckInService.GetByDateAsync(selectedDate, group);
    }

    private static string FormatLocalTime(DateTime utc) =>
        TimeZoneInfo.ConvertTimeFromUtc(utc, TimeZoneInfo.Local).ToString("HH:mm");
}
