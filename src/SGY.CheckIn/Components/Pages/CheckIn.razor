@page "/"
@attribute [Authorize]
@inject YouthService YouthService
@inject CheckInService CheckInService
@inject ToastService Toasts
@inject LabelPrinting Labels
@implements IDisposable
@inject ILogger<CheckIn> Logger

<PageTitle>Check In — SG Check-In</PageTitle>

<div class="checkin-page">
    <div class="search-panel">
        <input @ref="searchInputRef" type="text"
               value="@searchTerm"
               @oninput="OnSearchInput"
               onfocus="this.select()"
               placeholder="Search by name or surname..."
               autocomplete="off"
               autofocus
               class="search-box"
               aria-label="@($"Search for a {group.PersonNoun()}")" />

        @if (selected is null && searchTerm.Length > 0 && !isSearching && results.Count == 0)
        {
            <p class="search-hint">No one found matching "@searchTerm".</p>
        }

        @if (results.Count > 0)
        {
            <ul class="result-list">
                @foreach (var y in results)
                {
                    <li>
                        <button type="button"
                                class="result-row @(selected?.Id == y.Id ? "selected" : "")"
                                @onclick="() => SelectYouth(y)">
                            @* Dot only — enough to catch a leader's eye at the door without
                               spelling out why in front of the queue. The reason lives on
                               the profile. *@
                            @if (y.BehaviourStatus == BehaviourStatus.Red)
                            {
                                <span class="result-flag" role="img" aria-label="Flagged"></span>
                            }
                            @if (y.InCareVillage)
                            {
                                <span class="result-flag care" role="img" aria-label="Care Village"></span>
                            }
                            <span class="result-name">@Highlighted(y.FullName)</span>
                            @if (group.HasMinistries() && Birthdays.NearbyBirthday(y.DateOfBirth, Today) is not null)
                            {
                                <span class="result-birthday" title="Birthday this week"><BirthdayCake /></span>
                            }
                            <span class="result-grade">@group.Describe(y, Today)</span>
                            @if (checkedInTodayIds.Contains(y.Id))
                            {
                                <span class="badge-checked-in">Checked in</span>
                            }
                        </button>
                    </li>
                }
            </ul>
        }

        <a href="/register" class="register-link">+ Register a new @group.PersonNoun()</a>
    </div>

    @if (selected is not null)
    {
        <div class="detail-panel">
            <div class="detail-header">
                <div>
                    <h2>@selected.FullName</h2>
                    @if (group.Describe(selected, Today) is { } description)
                    {
                        <p class="detail-grade">@description</p>
                    }
                    @if (IsTooOld(selected))
                    {
                        <p class="age-flag-pill">Turns @KidsMinistries.AgeThisYear(selected.DateOfBirth, Today) this year: too old for Kids</p>
                    }
                    @* A week either side, so the leaders can make a fuss of them. (The label
                       gets a cake too.) *@
                    @if (group.HasMinistries() && Birthdays.NearbyBirthday(selected.DateOfBirth, Today) is { } birthday)
                    {
                        <p class="birthday-banner"><BirthdayCake /> @BirthdayText(birthday, selected.DateOfBirth)</p>
                    }
                </div>
                <a href="@($"/admin/youth/{selected.Id}/edit?from=checkin")" class="detail-edit">Edit details</a>
            </div>

            @* For the volunteer to confirm with the youth before checking them in; anything
               wrong is fixed through "Edit details", which comes straight back here. Leaders'
               notes are left off on purpose: the youth may be looking at this screen. *@
            <dl class="detail-list">
                @if (group.HasOwnCell())
                {
                    <div>
                        <dt>Cell number</dt>
                        <dd>@selected.CellNo</dd>
                    </div>
                }
                <div>
                    <dt>Date of birth</dt>
                    <dd>@selected.DateOfBirth.ToString("dd/MM/yyyy") <span class="detail-age">(age @Birthdays.AgeOn(selected.DateOfBirth, Today))</span></dd>
                </div>
                @if (group.HasParents())
                {
                    <div>
                        <dt>Parent / guardian</dt>
                        <dd>@selected.ParentName @selected.ParentSurname</dd>
                    </div>
                    <div>
                        <dt>Parent's cell</dt>
                        <dd>@selected.ParentCellNo</dd>
                    </div>
                }
                @* Medical notes are printed on the child's label anyway, so they're fine to show
                   here — unlike the leaders' comment. *@
                @if (group.HasMedical())
                {
                    <div>
                        <dt>Medical</dt>
                        <dd class="@(selected.Medical is null ? "" : "detail-medical")">@(selected.Medical ?? "None")</dd>
                    </div>
                }
            </dl>

            @if (todayCheckIn is not null)
            {
                @* No second "Check In": that would only add a duplicate row to the log. Undo
                   is for a youth checked in by mistake, so it asks first. Straight after
                   checking someone in, this is the confirmation that it worked. *@
                <div class="already-checked-in @(justCheckedIn ? "just-now" : "")" role="status">
                    <span class="already-checked-in-title">@(todayCheckIn.CheckedOutAt is not null ? "Checked out" : justCheckedIn ? "Checked in" : "Already checked in")</span>
                    <span class="already-checked-in-time">
                        @(todayCheckIn.CheckedOutAt is { } outAt
                            ? $"in at {FormatLocalTime(todayCheckIn.Timestamp)}, out at {FormatLocalTime(outAt)}"
                            : $"at {FormatLocalTime(todayCheckIn.Timestamp)}")
                    </span>
                </div>

                @* Kids: normally checked out by scanning their label; this is for a lost label. *@
                @if (group.HasCheckOut() && !justCheckedIn)
                {
                    @if (todayCheckIn.CheckedOutAt is null)
                    {
                        <button type="button" class="checkin-button secondary" @onclick="DoCheckOut">Check out</button>
                    }
                    else
                    {
                        <button type="button" class="undo-checkin-button" @onclick="UndoCheckOut">Undo check-out</button>
                    }
                }

                @if (!confirmingUndo)
                {
                    <button type="button" class="undo-checkin-button" @onclick="() => confirmingUndo = true">
                        Undo check-in
                    </button>
                }
                else
                {
                    <div class="undo-confirm">
                        <p>Undo @selected.Name's check-in at @FormatLocalTime(todayCheckIn.Timestamp)? Are you sure?</p>
                        <div class="archive-confirm-actions">
                            <button type="button" class="archive-confirm-button" @onclick="DoUndoCheckIn">Yes, undo</button>
                            <button type="button" class="cancel-link" @onclick="() => confirmingUndo = false">Cancel</button>
                        </div>
                    </div>
                }
            }
            else if (IsTooOld(selected) && !exceptionToday)
            {
                @* Past Kids' Ministry: checking them in takes a deliberate second step. *@
                <div class="age-flag" role="alert">
                    <p>@selected.Name is past Kids' Ministry, which ends with Refuel at 13.</p>
                    <button type="button" class="age-flag-button" @onclick="() => exceptionToday = true">Make an exception today</button>
                </div>
            }
            else
            {
                <button type="button" class="checkin-button" @onclick="DoCheckIn">Check In</button>
            }

            @if (group.PrintsLabels() && Labels.Mode != LabelMode.Off)
            {
                <button type="button" class="print-label-button" @onclick="() => Labels.PrintAsync(selected!, group)">
                    Print label
                </button>
            }
        </div>
    }

    <a href="/admin/log" class="today-summary">
        <span class="today-count">@todayCount</span>
        <span class="today-label">checked in today</span>
        @if (group.HasCheckOut())
        {
            <CheckOutProgress CheckedIn="todayCount" CheckedOut="todayCheckedOut" />
        }
    </a>
</div>

@code {
    private ElementReference searchInputRef;
    private string searchTerm = "";

    // The part of the name matching what's in the box, marked as it's typed. Follows the box
    // rather than the last search, so it keeps up between searches.
    private RenderFragment Highlighted(string name) => NameSearch.Find(name, searchTerm) is { } match
        ? @<text>@name[..match.Start]<mark>@name.Substring(match.Start, match.Length)</mark>@name[(match.Start + match.Length)..]</text>
        : @<text>@name</text>;
    private List<Youth> results = [];
    private HashSet<int> checkedInTodayIds = [];
    private bool isSearching;
    private CancellationTokenSource? debounceCts;

    private Youth? selected;
    private CheckInRecord? todayCheckIn;
    private bool confirmingUndo;
    // True while the person on screen is the one just checked in from this screen.
    private bool justCheckedIn;
    // Set when a volunteer lets a child too old for Kids in anyway; only for the one on screen.
    private bool exceptionToday;

    // Set when coming back from "Edit details", so the same youth is still selected.
    [SupplyParameterFromQuery(Name = "youth")]
    private int? ReturningYouthId { get; set; }
    private int todayCount;
    private int todayCheckedOut;
    private bool needsFocus = true;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private Group group = Group.Youth;

    protected override async Task OnInitializedAsync()
    {
        Labels.Changed += OnPrintingChanged;

        group = await AuthState.GetGroupAsync();
        await LoadTodayCountsAsync();

        if (ReturningYouthId is { } id && await YouthService.GetByIdAsync(id, group) is { IsArchived: false } youth)
        {
            await SelectYouth(youth);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && group.PrintsLabels())
        {
            // This device's label setting lives in its browser, so only now can it be read.
            await Labels.LoadAsync();
        }

        if (needsFocus)
        {
            needsFocus = false;
            await searchInputRef.FocusAsync();
        }
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";

        // A new search replaces whoever was picked from the last one.
        selected = null;
        todayCheckIn = null;
        confirmingUndo = false;
        justCheckedIn = false;
        exceptionToday = false;

        debounceCts?.Cancel();
        var cts = new CancellationTokenSource();
        debounceCts = cts;

        if (searchTerm.Length == 0)
        {
            results = [];
            checkedInTodayIds = [];
            isSearching = false;
            return;
        }

        try
        {
            isSearching = true;
            await Task.Delay(250, cts.Token);

            var found = await YouthService.SearchAsync(searchTerm, group, cts.Token);
            var checkedIn = found.Count > 0
                ? await CheckInService.GetTodayCheckedInYouthIdsAsync(group, cts.Token)
                : [];

            if (cts.Token.IsCancellationRequested) return;

            results = found;
            checkedInTodayIds = checkedIn;
            isSearching = false;
        }
        catch (TaskCanceledException)
        {
            // expected when the user keeps typing — a newer keystroke superseded this search
        }
    }

    private async Task SelectYouth(Youth youth)
    {
        // Close the list and show the picked name in the box, as if the search had been
        // typed out in full. Cancelling first stops a search still in flight from
        // reopening the list. (The box selects its text on focus, so typing starts over.)
        debounceCts?.Cancel();
        searchTerm = youth.FullName;
        results = [];
        isSearching = false;

        selected = youth;
        confirmingUndo = false;
        justCheckedIn = false;
        exceptionToday = false;
        todayCheckIn = await CheckInService.GetTodayCheckInAsync(youth.Id, group);
    }

    private async Task DoCheckIn()
    {
        if (selected is null)
        {
            return;
        }

        CheckInRecord record;
        try
        {
            record = await CheckInService.CheckInAsync(selected.Id, group);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Checking in youth {YouthId} failed", selected.Id);
            Toasts.ShowError($"Couldn't check {selected.FullName} in. Please try again.");
            return;
        }

        var child = selected;
        Toasts.ShowSuccess($"{child.FullName} checked in at {FormatLocalTime(DateTime.UtcNow)}");
        await LoadTodayCountsAsync();

        // Their details stay up as "Checked in" so the volunteer sees it worked; the search
        // box empties and takes the cursor for the next person, and typing replaces them.
        searchTerm = "";
        results = [];
        checkedInTodayIds = [];
        todayCheckIn = record;
        justCheckedIn = true;
        needsFocus = true;

        // After the screen has updated: the print dialog (if Chrome shows one) holds up
        // the page until it's dealt with, and a label sent to the print station takes a moment.
        if (group.PrintsLabels() && Labels.Mode != LabelMode.Off)
        {
            StateHasChanged();
            await Labels.PrintAsync(child, group);
        }
    }

    private async Task DoUndoCheckIn()
    {
        if (selected is null)
        {
            return;
        }

        var youth = selected;
        try
        {
            await CheckInService.UndoTodayCheckInAsync(youth.Id, group);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Undoing check-in for youth {YouthId} failed", youth.Id);
            Toasts.ShowError($"Couldn't undo {youth.FullName}'s check-in. Please try again.");
            return;
        }

        confirmingUndo = false;
        todayCheckIn = null;
        justCheckedIn = false;
        checkedInTodayIds.Remove(youth.Id);
        await LoadTodayCountsAsync();
        Toasts.ShowSuccess($"{youth.FullName}'s check-in undone");
    }

    private async Task LoadTodayCountsAsync()
    {
        todayCount = await CheckInService.GetTodayCountAsync(group);
        todayCheckedOut = group.HasCheckOut() ? await CheckInService.GetTodayCheckedOutCountAsync(group) : 0;
    }

    // A lost label: the same as scanning it.
    private async Task DoCheckOut()
    {
        if (selected is null || todayCheckIn is null)
        {
            return;
        }
        try
        {
            if (await CheckInService.CheckOutAsync(todayCheckIn.Id, group) is { } outAt)
            {
                todayCheckIn.CheckedOutAt = outAt;
                Toasts.ShowSuccess($"{selected.Name} checked out");
            }
            else
            {
                Toasts.ShowError($"Couldn't check {selected.Name} out: their check-in has been undone.");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Checking out check-in {CheckInId} failed", todayCheckIn.Id);
            Toasts.ShowError($"Couldn't check {selected.Name} out. Please try again.");
            return;
        }
        await LoadTodayCountsAsync();
    }

    private async Task UndoCheckOut()
    {
        if (selected is null || todayCheckIn is null)
        {
            return;
        }
        try
        {
            await CheckInService.UndoCheckOutAsync(todayCheckIn.Id, group);
            todayCheckIn.CheckedOutAt = null;
            Toasts.ShowSuccess($"{selected.Name} is checked in again");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Undoing the check-out of check-in {CheckInId} failed", todayCheckIn.Id);
            Toasts.ShowError("Couldn't undo the check-out. Please try again.");
            return;
        }
        await LoadTodayCountsAsync();
    }

    // This device's label setting read (it decides whether Print label shows).
    private void OnPrintingChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Labels.Changed -= OnPrintingChanged;

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Today);

    private bool IsTooOld(Youth person) =>
        group.HasMinistries() && KidsMinistries.IsTooOld(person.DateOfBirth, Today);

    private static string BirthdayText(DateOnly birthday, DateOnly dateOfBirth)
    {
        var age = birthday.Year - dateOfBirth.Year;
        var days = birthday.DayNumber - Today.DayNumber;
        return days switch
        {
            0 => $"Birthday today! Turns {age}",
            1 => $"Birthday tomorrow: turns {age}",
            -1 => $"Turned {age} yesterday",
            > 0 => $"Birthday on {birthday:dddd}: turns {age}",
            _ => $"Turned {age} on {birthday:dddd}",
        };
    }

    private static string FormatLocalTime(DateTime utc) =>
        TimeZoneInfo.ConvertTimeFromUtc(utc, TimeZoneInfo.Local).ToString("HH:mm");
}
