@page "/admin/settings"
@attribute [Authorize(Roles = Roles.Admin)]
@using System.ComponentModel.DataAnnotations
@inject VolunteerPasswordStore VolunteerPasswords
@inject BackupService Backups
@inject LabelService Labels
@inject ToastService Toasts
@inject ILogger<Settings> Logger

<PageTitle>Settings — SG Check-In</PageTitle>

<div class="register-page">
    <h1>Settings</h1>

    <EditForm Model="form" OnValidSubmit="HandleValidSubmit" OnInvalidSubmit="ShowFixFieldsError" FormName="volunteer-password">
        <DataAnnotationsValidator />

        @* One volunteer password per group, so each group's volunteers only see their own
           people. The admin password works for every group and lives in config. *@
        <fieldset>
            <legend>Volunteer passwords</legend>

            <div class="field">
                <span class="field-label">Group</span>
                <div class="report-presets">
                    @foreach (var g in Enum.GetValues<Group>())
                    {
                        <button type="button" class="preset @(passwordGroup == g ? "active" : "")"
                                aria-pressed="@(passwordGroup == g)" @onclick="() => passwordGroup = g">
                            @g.ToDisplayString()
                        </button>
                    }
                </div>
                @if (VolunteerPasswords.IsSet(passwordGroup))
                {
                    <p class="field-hint">@passwordGroup.ToDisplayString() has a volunteer password. Set a new one below to change it.</p>
                }
                else
                {
                    <p class="backup-status problem">No @passwordGroup.ToDisplayString() volunteer password yet, so @passwordGroup.ToDisplayString() volunteers can't sign in.</p>
                }
            </div>

            <label class="field">
                <span class="field-label">New password</span>
                <InputText @bind-Value="form.NewPassword" type="password" autocomplete="new-password" />
                <ValidationMessage For="() => form.NewPassword" />
            </label>

            <label class="field">
                <span class="field-label">Type it again</span>
                <InputText @bind-Value="form.ConfirmPassword" type="password" autocomplete="new-password" />
                <ValidationMessage For="() => form.ConfirmPassword" />
            </label>

            <p class="field-hint">
                Every device signed in as a @passwordGroup.ToDisplayString() volunteer will be signed
                out and need the new password. Other groups aren't affected.
            </p>
        </fieldset>

        <div class="form-actions">
            <button type="submit" class="submit-button" disabled="@isSubmitting">Set @passwordGroup.ToDisplayString() password</button>
        </div>
    </EditForm>

    @* One style for every label printer, so all the children's labels match. *@
    <fieldset>
        <legend>Kids name labels</legend>

        <div class="field">
            <span class="field-label">Style</span>
            <div class="report-presets">
                <button type="button" class="preset @(lightLabels ? "" : "active")" aria-pressed="@(!lightLabels)"
                        disabled="@isSavingLabelStyle" @onclick="() => SetLabelStyle(false)">Dark</button>
                <button type="button" class="preset @(lightLabels ? "active" : "")" aria-pressed="@lightLabels"
                        disabled="@isSavingLabelStyle" @onclick="() => SetLabelStyle(true)">Light</button>
            </div>
            <p class="field-hint">
                Dark has a solid black band down the left; light has a white band behind a black line,
                for less black on each label. Applies to every computer that prints labels, from the next label.
            </p>
        </div>

        <div class="field">
            <span class="field-label">Label size</span>
            <div class="report-presets">
                @foreach (var size in LabelSize.All)
                {
                    <button type="button" class="preset @(labelSize == size ? "active" : "")" aria-pressed="@(labelSize == size)"
                            disabled="@isSavingLabelStyle" @onclick="() => SetLabelSize(size)">
                        @size.Name <span class="preset-detail">@size.Dimensions</span>
                    </button>
                }
            </div>
            <p class="field-hint">
                The DYMO label loaded in the printers (@labelSize.Name is DYMO @labelSize.Codes).
                The label prints across the roll. Set the same paper size for the LabelWriter in the
                printer's settings, or labels come out cut off or shrunk.
            </p>
        </div>
    </fieldset>

    @* Backups are full copies of everything, made automatically once a week. The list
       is the way to get one off this computer: download it to a USB stick or the church
       Drive, since a backup on the same disk doesn't survive that disk failing. *@
    <fieldset>
        <legend>Backups</legend>

        <p class="field-hint">
            @IntervalText the app saves a full copy of everything as it is at that moment: every
            person in every group, check-in, leaders' note and setting. It keeps the @Backups.Keep newest copies
            and deletes older ones. Copies from Back up now and from restoring count toward that,
            so a mistake older than the oldest copy can't be undone. Download one now and then
            and keep it somewhere safe, like a USB stick or the church Drive.
        </p>

        @if (Backups.LastError is { } error)
        {
            <p class="backup-status problem" role="alert">The last backup failed: @error</p>
        }
        else if (backups.Count == 0)
        {
            <p class="backup-status problem">No backups yet. The first one is made a few minutes after the app starts, or press Back up now.</p>
        }
        else if (DateTime.Now - backups[0].CreatedLocal > Backups.Interval + TimeSpan.FromDays(7))
        {
            <p class="backup-status problem">The newest backup is from @DaysAgo(backups[0].CreatedLocal). Press Back up now.</p>
        }
        else
        {
            <p class="backup-status ok">Last backup: @backups[0].CreatedLocal.ToString("dd/MM/yyyy HH:mm") (@DaysAgo(backups[0].CreatedLocal))</p>
        }

        <div>
            <button type="button" class="submit-button backup-now" disabled="@isBackingUp" @onclick="BackUpNow">
                @(isBackingUp ? "Backing up…" : "Back up now")
            </button>
        </div>

        @if (backups.Count > 0)
        {
            <ul class="backup-list">
                @foreach (var backup in backups)
                {
                    <li>
                        <span class="backup-date">@backup.CreatedLocal.ToString("dd/MM/yyyy HH:mm")</span>
                        <span class="backup-size">@FormatSize(backup.SizeBytes)</span>
                        <a href="@($"/admin/backups/{backup.Name}")" download>Download</a>
                    </li>
                }
            </ul>
        }

        <p class="field-hint">Saved on the app's computer in <code>@Backups.Folder</code>. The README explains how to restore one.</p>
    </fieldset>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private PasswordForm form = new();
    private Group passwordGroup = Group.Youth;
    private bool isSubmitting;
    private IReadOnlyList<BackupFile> backups = [];
    private bool isBackingUp;
    private bool lightLabels;
    private LabelSize labelSize = LabelSize.LargeAddress;
    private bool isSavingLabelStyle;

    protected override async Task OnInitializedAsync()
    {
        // Start on the group the admin is working in; the buttons reach the others.
        passwordGroup = await AuthState.GetGroupAsync();
        backups = Backups.List();
        lightLabels = await Labels.IsLightAsync();
        labelSize = await Labels.GetSizeAsync();
    }

    private async Task SetLabelSize(LabelSize size)
    {
        if (size == labelSize)
        {
            return;
        }

        isSavingLabelStyle = true;
        try
        {
            await Labels.SetSizeAsync(size);
            labelSize = size;
            Toasts.ShowSuccess($"Kids labels now print on {size.Name} labels ({size.Dimensions}).");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Changing the label size failed");
            Toasts.ShowError("Couldn't change the label size. Please try again.");
        }
        finally
        {
            isSavingLabelStyle = false;
        }
    }

    private async Task SetLabelStyle(bool light)
    {
        if (light == lightLabels)
        {
            return;
        }

        isSavingLabelStyle = true;
        try
        {
            await Labels.SetLightAsync(light);
            lightLabels = light;
            Toasts.ShowSuccess($"Kids labels now print in the {(light ? "light" : "dark")} style.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Changing the label style failed");
            Toasts.ShowError("Couldn't change the label style. Please try again.");
        }
        finally
        {
            isSavingLabelStyle = false;
        }
    }

    private async Task HandleValidSubmit()
    {
        isSubmitting = true;
        var group = passwordGroup;
        try
        {
            await VolunteerPasswords.SetAsync(group, form.NewPassword);
            form = new();
            Toasts.ShowSuccess($"{group.ToDisplayString()} volunteer password set. {group.ToDisplayString()} volunteer devices need the new password.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Changing the {Group} volunteer password failed", group);
            Toasts.ShowError("Couldn't change the password. The old one still works. Please try again.");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void ShowFixFieldsError() =>
        Toasts.ShowError("Password not changed. Fix the fields marked in red.");

    private async Task BackUpNow()
    {
        isBackingUp = true;
        try
        {
            await Backups.CreateBackupAsync();
            Toasts.ShowSuccess("Backup saved. Download it from the list below to keep a copy.");
        }
        catch (Exception ex)
        {
            // BackupService has logged it, and LastError shows the reason above.
            Toasts.ShowError($"Backup failed: {ex.Message}");
        }
        finally
        {
            isBackingUp = false;
            backups = Backups.List();
        }
    }

    private static string DaysAgo(DateTime when)
    {
        var days = (int)(DateTime.Now - when).TotalDays;
        return days switch
        {
            0 => "today",
            1 => "1 day ago",
            _ => $"{days} days ago",
        };
    }

    private string IntervalText => (int)Backups.Interval.TotalDays switch
    {
        1 => "Once a day",
        7 => "Once a week",
        var days => $"Every {days} days",
    };

    private static string FormatSize(long bytes) =>
        bytes < 1024 * 1024 ? $"{Math.Max(1, bytes / 1024)} KB" : $"{bytes / (1024.0 * 1024):0.0} MB";

    private sealed class PasswordForm
    {
        [Required(ErrorMessage = "Enter a new password")]
        [MinLength(6, ErrorMessage = "Use at least 6 characters")]
        [StringLength(100)]
        public string NewPassword { get; set; } = "";

        [Compare(nameof(NewPassword), ErrorMessage = "The two passwords don't match")]
        public string ConfirmPassword { get; set; } = "";
    }
}
