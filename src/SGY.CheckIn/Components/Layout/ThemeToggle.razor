@* Switches this device between light and dark mode (theme.js). Plain JS, so it works on
   the sign-in page too, before there's a live connection. Shows the sun in dark mode and
   the moon in light mode: the one it switches to. *@
<button type="button" class="theme-toggle" onclick="sgTheme.toggle()" title="Light or dark mode" aria-label="Switch between light and dark mode">
    <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="4.2" />
        <path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6" />
    </svg>
    <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20.2 14.6A8.5 8.5 0 0 1 9.4 3.8a8.5 8.5 0 1 0 10.8 10.8Z" />
    </svg>
</button>
