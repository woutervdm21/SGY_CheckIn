@inherits LayoutComponentBase

<div class="app-shell">
    <header class="app-header">
        @* The brand names the group everything below belongs to. For an admin it's also the
           group switcher: picking another group posts straight away and reloads there. *@
        <div class="app-brand">
            <a href="/" class="app-brand-home" aria-label="Check In">
                <img src="sg-logo.avif" alt="" class="app-logo" />
            </a>
            <AuthorizeView Roles="@Roles.Admin">
                <Authorized>
                    <form method="post" action="/account/switch-group" class="group-switch">
                        <select name="group" aria-label="Switch group" onchange="this.form.submit()">
                            @foreach (var g in Enum.GetValues<Group>())
                            {
                                <option value="@g.ToKey()" selected="@(g == group)">SG @g.ToDisplayString()</option>
                            }
                        </select>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <a href="/" class="app-brand-name">SG @group.ToDisplayString()</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
        <nav class="app-nav">
            <NavLink href="/" Match="Microsoft.AspNetCore.Components.Routing.NavLinkMatch.All">Check In</NavLink>
            <NavLink href="/admin/log">Log</NavLink>
            <AuthorizeView Roles="@Roles.Admin">
                <NavLink href="/admin/profiles">Profiles</NavLink>
                <NavLink href="/admin/dashboard">Dashboard</NavLink>
                <NavLink href="/admin/settings">Settings</NavLink>
            </AuthorizeView>
        </nav>
        <div class="app-account">
            <AuthorizeView Roles="@Roles.Admin">
                <ChildContent><span class="role-badge role-admin">Admin</span></ChildContent>
            </AuthorizeView>
            <AuthorizeView Roles="@Roles.Volunteer">
                <ChildContent><span class="role-badge role-volunteer">Volunteer</span></ChildContent>
            </AuthorizeView>
            @* This device's label printing (Kids only): set once per device, so it's here
               rather than on the check-in screen. *@
            @if (group.PrintsLabels())
            {
                <NavLink href="/label-printing" class="header-icon" title="Label printing" aria-label="Label printing">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M7 9V3.5h10V9M7 17.5H5a2 2 0 0 1-2-2V11a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v4.5a2 2 0 0 1-2 2h-2" />
                        <path d="M7 14h10v6.5H7z" />
                    </svg>
                </NavLink>
            }
            <ThemeToggle />
            <form method="post" action="/account/logout" class="app-signout">
                <button type="submit">Sign out</button>
            </form>
        </div>
    </header>

    <main class="app-main">
        @Body
    </main>

    <footer class="app-footer">SG Check-In v@(AppInfo.Version)</footer>
</div>

<ToastHost />
<PrintStationListener Group="group" />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    // Only changes through sign-in or the switcher, both of which reload the page.
    private Group group = Group.Youth;

    protected override async Task OnInitializedAsync() => group = await AuthState.GetGroupAsync();
}
