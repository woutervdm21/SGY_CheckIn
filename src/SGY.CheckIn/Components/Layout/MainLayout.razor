@inherits LayoutComponentBase

<div class="app-shell">
    <header class="app-header">
        <a href="/" class="app-brand">
            <img src="sg-logo.avif" alt="" class="app-logo" />
            <span>SGY Check-In</span>
        </a>
        <nav class="app-nav">
            <NavLink href="/" Match="Microsoft.AspNetCore.Components.Routing.NavLinkMatch.All">Check In</NavLink>
            <NavLink href="/admin/log">Log</NavLink>
            <AuthorizeView Roles="@Roles.Admin">
                <NavLink href="/admin/profiles">Profiles</NavLink>
            </AuthorizeView>
        </nav>
        <div class="app-account">
            <AuthorizeView Roles="@Roles.Admin">
                <ChildContent><span class="role-badge role-admin">Admin</span></ChildContent>
            </AuthorizeView>
            <AuthorizeView Roles="@Roles.Volunteer">
                <ChildContent><span class="role-badge role-volunteer">Volunteer</span></ChildContent>
            </AuthorizeView>
            <form method="post" action="/account/logout" class="app-signout">
                <button type="submit">Sign out</button>
            </form>
        </div>
    </header>

    <main class="app-main">
        @Body
    </main>

    <footer class="app-footer">SGY Check-In v@(AppInfo.Version)</footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
